# Anthropic API key used by the pipeline for every generation and edit call.
ANTHROPIC_API_KEY=
# Optional override for the model behind the "sonnet" setting key (default in config/settings.default.json).
MODEL_SONNET=
# Optional override for the model behind the "opus" setting key (default in config/settings.default.json).
MODEL_OPUS=
# Path to the pandoc binary if it is not on PATH.
PANDOC_PATH=
